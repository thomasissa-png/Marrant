+/**
+ * Décision de Thomas du 14/11 (espace ouvert seulement) : les 10 vannes gratuites réparties sur au moins
+ * 5 catégories de la rangée de /vannes, par une règle dans le code (`selectionGratuite`), sans écriture en base.
+ */
+import { CATEGORIES_VANNES, groupeDeCategorie, selectionGratuite } from "@/config/vannes-categories";
+
+// Distribution du seed (base jetable e2e et préversion) : BOULOT d'abord, comme les plus récentes.
+const SEED: Record<string, number> = {
+  BOULOT: 19, CULTUREL: 10, SITUATION: 10, AUTODERISION: 10, SOIREES: 8, OBSERVATIONNEL: 6, DATING: 5,
+  ECOLE: 5, COUPLE: 5, GAMING: 5, PARENTS: 4, ABSURDE: 4, RESEAUX_SOCIAUX: 3, JEUX_DE_MOTS: 1,
+};
+const catalogue = Object.entries(SEED).flatMap(([cat, n]) => Array.from({ length: n }, (_, i) => ({ id: `${cat}-${i}`, category: cat })));
+
+describe("vannes gratuites réparties (espace ouvert)", () => {
+  it("10 vannes, au moins 5 groupes de la rangée, dans l'ordre du catalogue", () => {
+    const choisies = selectionGratuite(catalogue, 10);
+    expect(choisies).toHaveLength(10);
+    expect(new Set(choisies.map((c) => groupeDeCategorie(c.category))).size).toBeGreaterThanOrEqual(5);
+    const rangs = choisies.map((c) => catalogue.indexOf(c));
+    expect([...rangs].sort((a, b) => a - b)).toEqual(rangs);
+  });
+
+  it("chaque catégorie de la base appartient au plus à un groupe de la rangée ; « Toutes » en tête", () => {
+    expect(CATEGORIES_VANNES[0]).toEqual({ value: "", label: "Toutes" });
+    const toutes = CATEGORIES_VANNES.flatMap((c) => (c.value ? c.value.split(",") : []));
+    expect(new Set(toutes).size).toBe(toutes.length);
+    expect(groupeDeCategorie("DATING")).toBe("COUPLE,DATING");
+  });
+
+  it("un catalogue d'une seule catégorie donne ses 10 plus récentes", () => {
+    const seul = Array.from({ length: 15 }, (_, i) => ({ id: `b${i}`, category: "BOULOT" }));
+    expect(selectionGratuite(seul, 10).map((c) => c.id)).toEqual(seul.slice(0, 10).map((c) => c.id));
+  });
+});
