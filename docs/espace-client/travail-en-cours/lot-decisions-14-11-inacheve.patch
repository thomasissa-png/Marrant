@@ -0,0 +1,54 @@
+/**
+ * Catégories de /vannes : la rangée de filtres (groupes de catégories de la base, par contexte puis par style).
+ * Module sans dépendance : importable par la liste (client) et par l'API (serveur). Avant s24, la rangée vivait
+ * dans `components/vannes/vannes-list.tsx` ; déplacée ici sans changement pour que la sélection des vannes
+ * gratuites (interrupteur de l'espace ouvert) se répartisse sur ces mêmes groupes.
+ */
+export const CATEGORIES_VANNES = [
+  { value: "", label: "Toutes" },
+  // Par contexte : où tu la sors
+  { value: "SITUATION,OBSERVATIONNEL,CULTUREL", label: "Vie quotidienne" },
+  { value: "BOULOT", label: "Boulot & Collègues" },
+  { value: "COUPLE,DATING", label: "Couple & Dating" },
+  { value: "SOIREES", label: "Soirées & Apéro" },
+  { value: "ECOLE", label: "École & Études" },
+  { value: "PARENTS", label: "Famille" },
+  { value: "RESEAUX_SOCIAUX,GAMING", label: "Digital & Gaming" },
+  // Par style : comment elle marche
+  { value: "AUTODERISION", label: "Autodérision" },
+  { value: "ABSURDE", label: "Absurde" },
+  { value: "JEUX_DE_MOTS", label: "Jeux de mots" },
+] as const;
+
+/** Groupe de filtre d'une catégorie de la base (sa valeur dans la rangée), ou la catégorie elle-même. */
+export function groupeDeCategorie(categorie: string): string {
+  return CATEGORIES_VANNES.find((c) => c.value !== "" && c.value.split(",").includes(categorie))?.value ?? categorie;
+}
+
+/**
+ * Vannes gratuites, interrupteur de l'espace ouvert (décision de Thomas du 14/11, `docs/founder-preferences.md`) :
+ * `limite` vannes réparties sur les groupes de la rangée, à tour de rôle. Ordre d'entrée : celui du catalogue
+ * (les plus récentes d'abord) ; à chaque tour, la plus récente de chaque groupe pas encore pris, les groupes dans
+ * l'ordre où ils apparaissent. Avec au moins 5 groupes présents, les 10 vannes en couvrent au moins 5. Règle dans
+ * le code seulement : aucune écriture en base, le seed est inchangé.
+ */
+export function selectionGratuite<T extends { id: string; category: string }>(candidats: readonly T[], limite: number): T[] {
+  const parGroupe = new Map<string, T[]>();
+  for (const c of candidats) {
+    const g = groupeDeCategorie(c.category);
+    const liste = parGroupe.get(g);
+    if (liste) liste.push(c);
+    else parGroupe.set(g, [c]);
+  }
+  const files = Array.from(parGroupe.values());
+  const choisis: T[] = [];
+  for (let tour = 0; choisis.length < limite && files.some((f) => f.length > tour); tour++) {
+    for (const f of files) {
+      if (choisis.length >= limite) break;
+      if (f[tour]) choisis.push(f[tour]);
+    }
+  }
+  // Dans l'ordre du catalogue, comme le reste de la liste.
+  const rang = new Map(candidats.map((c, i) => [c.id, i]));
+  return choisis.sort((a, b) => (rang.get(a.id) ?? 0) - (rang.get(b.id) ?? 0));
+}
