# En-têtes de la couche assets Cloudflare Workers (copié dans .open-next/assets par OpenNext).
# Ne s'applique qu'aux fichiers servis DIRECTEMENT par la couche assets. Les réponses
# produites par le Worker (dont /_next/static/chunks/app/*, voir run_worker_first dans
# wrangler.jsonc) reçoivent leur Cache-Control dans cloudflare/worker.ts.
# Sans ce fichier, Cloudflare sert tout en « max-age=0, must-revalidate ».

# Fichiers Next hashés : contenu immuable pour une URL donnée.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Polices et icônes non hashées : 1 jour, puis revalidation en arrière-plan (7 jours).
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
