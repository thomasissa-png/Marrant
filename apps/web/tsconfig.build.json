{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2017",
    "downlevelIteration": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/__tests__/**/*",
    "__tests__/**/*",
    "playwright/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
