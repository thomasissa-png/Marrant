# =============================================================================
# .env.example — Toutes les variables lues par le code Marrant
# =============================================================================
# En prod : configurer dans Replit Secrets (icône cadenas). NE PAS versionner
# les valeurs réelles. Ce fichier documente le CATALOGUE — les valeurs sont
# des exemples factices non-fonctionnels.
# =============================================================================

# ---------- Base de données (Neon PostgreSQL via Replit) ----------
# Neon peut recycler l'URL après un redéploiement — TOUJOURS lue au runtime.
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------- NextAuth ----------
NEXTAUTH_URL="https://deviens-marrant.fr"
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me-32-caracteres-aleatoires-minimum"

# ---------- Google OAuth (login "Continuer avec Google") ----------
GOOGLE_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxx"

# ---------- Anthropic Claude API ----------
# Clé API principale (obligatoire pour tous les crons IA).
ANTHROPIC_API_KEY=""
# Surcharges optionnelles des modèles centralisés (voir src/lib/ai/client.ts).
# Permettent de migrer d'un modèle sans redéploiement de code — sur retrait
# annoncé, il suffit d'écrire le nouvel ID ici dans Replit Secrets.
# Valeurs actives par défaut dans le code : Sonnet 5.5, Opus 5.5.
ANTHROPIC_SONNET_MODEL="claude-sonnet-5-5"
ANTHROPIC_OPUS_MODEL="claude-opus-5-5"
# Niveau d'effort (thinking budget) par défaut pour les appels sans override.
# Valeurs supportées : "low" | "medium" | "high" | "xhigh" | "max".
# Défaut du code : "low" (économique, adapté à la génération de contenu).
ANTHROPIC_EFFORT="low"
# Toggle revue batch quotidienne du Director.
ENABLE_REVIEW_BATCH="false"
# Relecture automatique des vannes/conseils générés (charte s11, 1 lot/jour 3h-4h UTC).
# "false" = kill-switch. Vide = actif.
COPY_REVIEW_ENABLED=""
# Taille du lot quotidien (vannes ET conseils). Vide = 25.
COPY_REVIEW_BATCH=""
# Version de charte (entier ≥ 1). Incrémenter pour relire tout le corpus. Vide = 1.
COPY_REVIEW_VERSION=""
# Décryptage IA au boot des vannes sans décryptage : "1" pour couper.
SKIP_JOKE_DECRYPTAGE_AI_BACKFILL=""
# Taille du lot de décryptage IA par boot. Vide = 15.
JOKE_DECRYPTAGE_AI_BACKFILL_BATCH=""

# ---------- Stripe (abonnement Premium) ----------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY="pk_test_XXXXXXXXXXXXXXXXXXXXXXXX"
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID="price_XXXXXXXXXXXXXXXXXXXX"
# Formule annuelle 24,99 €/an (prix Stripe récurrent annuel). Lu au runtime :
# absent ou placeholder = annuel masqué partout (/abonnement, JSON-LD, FAQ, llms.txt)
# et checkout annuel refusé en 503, sans repli sur le mensuel.
STRIPE_PREMIUM_ANNUAL_PRICE_ID="price_XXXXXXXXXXXXXXXXXXXX"
# Prix affiché côté client (en centimes, ex : 299 = 2,99 €).
STRIPE_PREMIUM_PRICE_CENTS="299"
# Case « J'accepte les CGU » sur la page de paiement Stripe (consent_collection).
# Mettre "true" SEULEMENT après avoir déclaré l'URL des CGU dans Stripe
# (Paramètres > Informations publiques : https://deviens-marrant.fr/cgu).
# Vide ou autre valeur = pas de case. Si Stripe refuse quand même, le checkout
# repart sans la case et lève l'alerte admin `paiement-checkout-cgu` (audit s16).
STRIPE_CHECKOUT_CGU_CONSENT=""

# ---------- YouTube Data API v3 (agent vidéos) ----------
YOUTUBE_API_KEY="AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ---------- Resend (email transactionnel + alertes admin) ----------
RESEND_API_KEY=""
# Optionnel — expéditeur, défaut : "Deviens Marrant <noreply@deviens-marrant.fr>"
EMAIL_FROM="Deviens Marrant <noreply@deviens-marrant.fr>"

# ---------- Administration ----------
# Mot de passe du dashboard admin + des APIs admin (bearer token).
ADMIN_PASSWORD="change-me-mot-de-passe-fort"
# Bearer token pour sécuriser tous les endpoints /api/cron/*.
CRON_SECRET="change-me-bearer-token-crons"

# ---------- Analytics Umami (self-hosted, publique) ----------
NEXT_PUBLIC_UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# API Umami Cloud (serveur uniquement) : rapport hebdomadaire des visites du lundi.
# Absents : le rapport est ignoré (avertissement dans les logs), rien ne casse.
UMAMI_API_KEY="xxxx-cle-api-umami"
UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ---------- URL publique (sitemap, OpenGraph, emails) ----------
NEXT_PUBLIC_SITE_URL="https://deviens-marrant.fr"

# ---------- IndexNow (soumission SEO Bing + Yandex) ----------
INDEXNOW_KEY="0123456789abcdef0123456789abcdef"

# ---------- Core Web Vitals (endpoint de collecte publique) ----------
NEXT_PUBLIC_CWV_ENDPOINT="/api/analytics/vitals"

# ---------- Verifications propriétaires (moteurs et réseaux) ----------
# Nouveau (lot 1 SEO) — voir docs SEO pour la meta tag Bing Webmaster.
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# Nouveau (lot 1 SEO) — URLs des profils sociaux séparés par des virgules.
# Ex : "https://twitter.com/marrant,https://instagram.com/marrant,https://linkedin.com/company/marrant"
NEXT_PUBLIC_SOCIAL_PROFILES=""

# ---------- Buffer (publication social media) ----------
BUFFER_ACCESS_TOKEN="1/xxxxxxxxxxxxxxxxxxxxxxxx"
BUFFER_ORGANIZATION_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
BUFFER_CHANNEL_TWITTER="xxxxxxxxxxxxxxxxxxxxxxxx"
# Note : les channels LinkedIn et Instagram sont ajoutés à la même variable
# BUFFER_CHANNEL_TWITTER par erreur historique — voir refonte social pour
# les 5 channels séparés une fois exposés dans le code.

# ---------- Réseaux sociaux — accès direct (fallback / legacy) ----------
# Encore lus par le code au cas où Buffer serait indisponible.
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_ORGANIZATION_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""

# ---------- Mobile (Capacitor) ----------
# RevenueCat — In-App Purchases iOS + Android
NEXT_PUBLIC_REVENUECAT_API_KEY_IOS=""
NEXT_PUBLIC_REVENUECAT_API_KEY_ANDROID=""
REVENUECAT_WEBHOOK_SECRET=""
# Push Firebase (Android)
FCM_SERVER_KEY=""
# Push APNs (iOS)
APNS_BUNDLE_ID="fr.deviensmarrant.app"
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------- Build / runtime ----------
# Injecté par le pipeline de build pour dater le sitemap (dynamique).
BUILD_DATE="2026-09-29"
# Port par défaut Replit — mappé par la plateforme, ne pas modifier sauf raison.
PORT="5000"
