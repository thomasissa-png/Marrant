// Schéma Prisma — deviens-marrant.fr
// Base de données PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH — NextAuth.js
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// UTILISATEURS
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash      String?
  passwordChangedAt DateTime?
  plan              Plan      @default(FREE)
  level         UserLevel @default(NOVICE)
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveAt  DateTime?
  // CEO Agent — fenêtre attribution conversion 7j (cf docs/product/ceo-agent-specs.md §11)
  lastCeoTouchpoint DateTime?
  // Si true, le CEO ne contacte JAMAIS cet utilisateur (vérif synchrone avant tout draft)
  emailOptOut       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations NextAuth
  accounts Account[]
  sessions Session[]

  // Relations métier
  favorites    UserFavorite[]
  subscription Subscription?
  jokeLikes    JokeLike[]
  pathProgress  UserPathProgress[]
  featureVotes  FeatureVote[]
  ceoLead       CeoLead?
  pushTokens   PushToken[]

  @@index([email])
}

enum Plan {
  FREE
  PREMIUM
}

enum UserLevel {
  NOVICE
  APPRENTI
  FARCEUR
  COMIQUE
  LEGENDE
}

// ==========================================
// BLAGUES
// ==========================================

model Joke {
  id            String        @id @default(cuid())
  content       String        @db.Text
  punchline     String        @db.Text
  category      JokeCategory
  maturityLevel Int           @default(1) // 1-5
  type          JokeType      @default(CLASSIQUE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  generatedByAI Boolean       @default(false)

  // Relations
  dailyContents DailyContent[]
  favorites     UserFavorite[]
  likes         JokeLike[]

  @@index([category])
  @@index([isActive])
}

enum JokeCategory {
  AUTODERISION
  SITUATION
  ABSURDE
  OBSERVATIONNEL
  JEUX_DE_MOTS
  CULTUREL
  COUPLE
  BOULOT
  ECOLE
  GAMING
  RESEAUX_SOCIAUX
  DATING
  SOIREES
  PARENTS
}

enum JokeType {
  SUBTIL
  CLASSIQUE
  ABSURDE
  ONE_LINER
  STORY
  DIALOGUE
  QA
}

model JokeLike {
  id        String   @id @default(cuid())
  userId    String
  jokeId    String
  isLike    Boolean  // true = like, false = dislike
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joke Joke @relation(fields: [jokeId], references: [id], onDelete: Cascade)

  @@unique([userId, jokeId])
  @@index([jokeId])
}

// ==========================================
// CONSEILS
// ==========================================

model Tip {
  id         String        @id @default(cuid())
  title      String
  content    String        @db.Text
  category   TipCategory
  difficulty TipDifficulty
  example    String        @db.Text
  exercise   String        @db.Text
  isActive      Boolean       @default(true)
  generatedByAI Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  dailyContents DailyContent[]
  favorites     UserFavorite[]
  pathSteps     LearningPathStep[]

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
}

enum TipCategory {
  TIMING
  AUTODERISION
  OBSERVATION
  REPARTIE
  STORYTELLING
  ABSURDE
  JEUX_DE_MOTS
}

enum TipDifficulty {
  DEBUTANT
  INTERMEDIAIRE
  EXPERT
}

// ==========================================
// PARCOURS D'APPRENTISSAGE
// ==========================================

model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  slug        String   @unique
  duration    String   // ex: "4 semaines"
  difficulty  TipDifficulty
  icon        String   // emoji
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       LearningPathStep[]
  userProgress UserPathProgress[]

  @@index([isActive])
}

model LearningPathStep {
  id              String       @id @default(cuid())
  learningPathId  String
  tipId           String
  order           Int
  dayNumber       Int          // Jour dans le parcours

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  tip          Tip          @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, order])
  @@index([learningPathId])
}

model UserPathProgress {
  id              String       @id @default(cuid())
  userId          String
  learningPathId  String
  currentStep     Int          @default(0)
  completedSteps  Int[]        // Array of completed step orders
  startedAt       DateTime     @default(now())
  completedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
}

// ==========================================
// VIDÉOS
// ==========================================

model Video {
  id          String          @id @default(cuid())
  youtubeId   String          @unique
  title       String
  channelName String
  duration    String          // Format ISO 8601 (PT5M30S)
  category    TipCategory     // Même catégories que les conseils
  difficulty  TipDifficulty   // Même niveaux que les conseils
  description String          @db.Text
  technique   String          // Technique humoristique principale
  learnings   String[]        // Points clés à retenir de la vidéo
  exercise    String?         @db.Text  // Exercice pratique lié à la vidéo
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  generatedByAI Boolean         @default(false)

  // Relations
  dailyContents DailyContent[]
  favorites     UserFavorite[]

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
}

// ==========================================
// CONTENU DU JOUR
// ==========================================

model DailyContent {
  id      String   @id @default(cuid())
  date    DateTime @unique @db.Date
  jokeId  String
  tipId   String
  videoId String?

  joke  Joke   @relation(fields: [jokeId], references: [id], onDelete: Cascade)
  tip   Tip    @relation(fields: [tipId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id])

  @@index([date])
}

// ==========================================
// PLAN DE CONTENU MENSUEL (agents IA)
// ==========================================

model ContentPlan {
  id          String          @id @default(cuid())
  agentType   ContentAgentType
  month       Int             // 1-12
  year        Int
  entries     ContentPlanEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([agentType, month, year])
}

model ContentPlanEntry {
  id            String         @id @default(cuid())
  planId        String
  dayOfMonth    Int            // 1-31
  category      String         // catégorie prévue
  theme         String         // thème/sujet prévu
  targetPersona String         // YANIS | SOPHIE | MARC
  status        PlanEntryStatus @default(PLANNED)
  contentId     String?        // ID du contenu créé (joke/tip/video)
  createdAt     DateTime       @default(now())

  plan ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayOfMonth])
  @@index([planId])
  @@index([status])
}

enum ContentAgentType {
  JOKE
  TIP
  VIDEO
  SEO_BLOG
}

enum SeoEntryStatus {
  PLANNED
  PUBLISHED
  SKIPPED
}

enum PlanEntryStatus {
  PLANNED
  PUBLISHED
  SKIPPED
}

// ==========================================
// FAVORIS
// ==========================================

model UserFavorite {
  id          String      @id @default(cuid())
  userId      String
  contentType ContentType
  jokeId      String?
  tipId       String?
  videoId     String?
  createdAt   DateTime    @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joke  Joke?  @relation(fields: [jokeId], references: [id], onDelete: Cascade)
  tip   Tip?   @relation(fields: [tipId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, jokeId])
  @@unique([userId, contentType, tipId])
  @@unique([userId, contentType, videoId])
  @@index([userId])
}

enum ContentType {
  JOKE
  TIP
  VIDEO
}

// ==========================================
// ABONNEMENTS (Stripe)
// ==========================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  provider    String?  // "stripe" | "revenuecat" | ...
  eventType   String?  // type de l'event (ex: "INITIAL_PURCHASE")
  receivedAt  DateTime @default(now())
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@index([provider, eventType])
}

/// Push notification tokens (FCM Android + APNs iOS) — Phase 5 mobile.
/// Un user peut avoir plusieurs devices, mais un token est unique.
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   // "android" | "ios"
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@index([platform])
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ==========================================
// VOTES FONCTIONNALITÉS À VENIR
// ==========================================

model FeatureVote {
  id          String   @id @default(cuid())
  userId      String
  featureSlug String   // ex: "whatsapp", "communaute", "nouveaux-parcours"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureSlug])
  @@index([featureSlug])
}

// ==========================================
// BLOG (Agent SEO)
// ==========================================

model BlogArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  excerpt     String            @db.Text
  content     String            @db.Text
  category    String
  readingTime String
  targetKeyword String          // mot-clé principal ciblé
  metaTitle   String?           // title SEO custom si différent du titre
  metaDescription String?       @db.Text
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  generatedByAI Boolean         @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isPublished])
  @@index([slug])
  @@index([publishedAt])
}

// ==========================================
// SOCIAL MEDIA (Agent Social)
// ==========================================

model SocialPost {
  id              String              @id @default(cuid())
  platform        SocialPlatform
  format          SocialFormat
  content         String              @db.Text
  hook            String              // Les 5-10 premiers mots (scroll-stopping)
  cta             String?             // Call to action de fin
  hashtags        String[]
  targetPersona   String              // YANIS | SOPHIE | MARC
  sourceType      String?             // JOKE | TIP | VIDEO | BLOG | ORIGINAL
  sourceId        String?             // ID du contenu source (jokeId, tipId, etc.)
  threadParts     String[]            @default([]) // Pour les threads Twitter multi-tweets
  status          SocialPostStatus    @default(PENDING)
  directorScore   Int?                // Score de validation du directeur (1-10)
  directorNote    String?             @db.Text
  approvedBy      String?             // "admin" si approuvé manuellement, "director" si auto (score >= 9), null si pas encore approuvé
  scheduledAt     DateTime            // Heure de publication prévue
  publishedAt     DateTime?
  externalId      String?             // ID du post sur la plateforme (tweet ID, etc.)
  imageUrl        String?             // URL Replit Object Storage pour images Instagram (pré-générées)
  // Analytics (remplies par le cron social-analytics)
  impressions     Int                 @default(0)
  likes           Int                 @default(0)
  retweets        Int                 @default(0)
  replies         Int                 @default(0)
  clicks          Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([platform])
  @@index([scheduledAt])
  @@index([publishedAt])
}

enum SocialPlatform {
  TWITTER
  THREADS
  LINKEDIN
  INSTAGRAM
}

enum SocialFormat {
  TWEET
  THREAD
  CAROUSEL
  POST
  QUOTE_ANALYSIS
  TECHNIQUE_DU_JOUR
  MINI_STANDUP        // s7 : Twitter
  POTE_AU_TAF         // s7 : LinkedIn
  IMAGE_QUI_CLAQUE    // s7 : Instagram
}

enum SocialPostStatus {
  PENDING     // Généré, en attente de validation
  APPROVED    // Validé par l'admin, prêt à publier
  PUBLISHED   // Publié sur la plateforme
  REJECTED    // Rejeté par l'admin
  FAILED      // Erreur de publication
}

model SeoCalendar {
  id            String          @id @default(cuid())
  weekNumber    Int             // 1-52
  year          Int
  targetKeyword String          // mot-clé cible pour cet article
  articleTitle  String?         // titre planifié
  status        SeoEntryStatus  @default(PLANNED)
  articleId     String?         // ID de l'article créé
  notes         String?         @db.Text // notes de l'agent sur le choix
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([weekNumber, year])
  @@index([status])
}

// ==========================================
// INFRASTRUCTURE — Scheduler locks & observabilité LLM
// ==========================================

/// Verrou anti-concurrent pour les jobs schedulés (instrumentation.ts).
/// Permet d'éviter que deux instances (scheduler interne + cron HTTP)
/// lancent le même pipeline en parallèle. TTL automatique via `expiresAt`
/// pour que les locks orphelins (process crash) soient réacquérables.
///
/// jobKey format : "<job-name>-<YYYY-MM-DD>" (daily) ou "<job-name>-<YYYY>-W<nn>" (weekly).
model JobLock {
  id         String   @id @default(cuid())
  jobKey     String   @unique
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Log de consommation LLM Anthropic — instrumentation coût par appel.
/// Un row par appel réussi ou échoué à `callWithRetry`.
/// Permet d'agréger le coût par agent/fonction/jour pour piloter les optimisations.
///
/// Écriture silent-fail : si la DB est inaccessible, `logLLMUsage` log console
/// et continue — ne JAMAIS bloquer le pipeline de génération sur une erreur d'instrumentation.
model LlmUsageLog {
  id                  String   @id @default(cuid())
  agent               String   // ex: "joke-agent", "standup-director"
  fn                  String   // ex: "generateDailyJoke", "validateJoke"
  model               String   // ex: "claude-sonnet-4-20250514"
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int      @default(0)
  cacheCreationTokens Int      @default(0)
  costUsd             Float
  durationMs          Int?
  success             Boolean  @default(true)
  errorMessage        String?  @db.Text
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([agent, fn])
  @@index([createdAt, agent])
}

/// Lock idempotent au jour près pour `runDailySocialJob`.
/// Corrige P1 s08/04 race condition intra-heure : si le run de 4h UTC dépasse
/// 15 min, le scheduler peut relancer un 2e run avant que le 1er termine ses
/// INSERT SocialPost → duplication. Le lock garantit qu'un seul run/jour
/// franchit la barrière, même en cas de fenêtre catch-up multiple.
///
/// Différent de `JobLock` (TTL court, lock par run) : ici PK unique par jour,
/// pas de TTL — le lock vit la journée et est nettoyé par cron de purge.
model SocialPostDailyLock {
  id        String   @id @default(cuid())
  dateUTC   String   @unique // format "YYYY-MM-DD" (UTC)
  createdAt DateTime @default(now())
}

// ==========================================
// CEO AGENT — Phase 5 (cf docs/product/ceo-agent-specs.md)
// ==========================================

/// Configuration runtime du CEO Agent — kill-switch, budget, toggles auto-send.
/// Une seule ligne en DB (singleton). Toggle depuis `/admin/ceo`.
model CeoConfig {
  id                    String   @id @default(cuid())
  enabled               Boolean  @default(false) // false = ceoTick return immédiat
  dailyBudgetEur        Float    @default(2.0)
  maxActionsPerTick     Int      @default(3)
  autoSendEmail         Boolean  @default(false) // true à partir de S3
  autoSendDm            Boolean  @default(false) // true à partir de S4
  killSwitchReason      String?  // raison si enabled=false (audit CNIL)
  socialOutboundEnabled Boolean  @default(false) // toggle mois 3+
  dryRun                Boolean  @default(true)  // si true, tout en DRAFT (jamais envoyé)
  updatedAt             DateTime @updatedAt
}

/// Task store persistant — cœur de l'agent. Un row = une action planifiée.
model CeoTask {
  id           String        @id @default(cuid())
  type         CeoTaskType
  status       CeoTaskStatus @default(PENDING)
  payload      Json          // données contextuelles (leadId, playbookId, opportunityId, signal, etc.)
  scheduledFor DateTime
  attempts     Int           @default(0) // max 3, au-delà = FAILED
  contestedAt  DateTime?     // art. 22 RGPD — contestation utilisateur
  result       Json?         // résultat de l'exécution (messageId, errorCode, etc.)
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status])
  @@index([scheduledFor])
  @@index([type])
}

/// Mémoire long-terme + court-terme de l'agent (clé/valeur, namespace par préfixe).
/// Exemples de clés : "weekly_report:last_generated_at", "lead:<id>:last_signal", "global:top_playbook_30d"
model CeoMemory {
  id        String    @id @default(cuid())
  namespace String    // ex: "global", "lead:<id>", "weekly_report"
  key       String
  value     Json
  expiresAt DateTime? // TTL optionnel (mémoire court-terme)
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

  @@unique([namespace, key])
  @@index([namespace])
  @@index([expiresAt])
}

/// CRM léger — leads identifiés et scorés.
model CeoLead {
  id             String        @id @default(cuid())
  userId         String?       @unique
  email          String?       // clair ici (champ protégé), hashé dans CeoAuditLog
  socialHandle   String?
  source         String        // "email_signup" | "twitter_dm" | "linkedin_mention" | "instagram_dm" | "haro_press"
  score          Int           @default(0) // signaux S1-S12 → 0-50
  signals        Json          @default("{}") // snapshot signaux actifs
  status         CeoLeadStatus @default(COLD)
  lastContactAt  DateTime?
  lastPlaybook   String?       // dernier playbook utilisé (P1-P7)
  touchpoints    Int           @default(0) // max 3 sur durée de vie free
  optOut         Boolean       @default(false) // opposition art. 21 RGPD
  history        Json          @default("[]") // tableau interactions CEO
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages CeoOutboundMessage[]

  @@index([status])
  @@index([score])
  @@index([userId])
}

/// Messages outbound + inbound, tous canaux confondus.
/// PII protégé : `recipient` clair ici, hashé dans CeoAuditLog.
model CeoOutboundMessage {
  id                  String              @id @default(cuid())
  channel             CeoOutboundChannel
  direction           CeoOutboundDirection @default(OUTBOUND)
  recipient           String              // email ou handle social
  subject             String?             // emails uniquement
  content             String              @db.Text
  status              CeoOutboundStatus   @default(PENDING)
  directorScore       Int?                // score Stand-Up Director (0-10)
  directorValidated   Boolean             @default(false)
  directorNote        String?             @db.Text
  playbook            String?             // P1-P7 ou "backlink_<source>"
  // Patch HAUTE Phase 3 : passage S2→S3 critère "drafts validés sans correction"
  requiresHumanReview Boolean             @default(false)
  sentAt              DateTime?
  opens               Int                 @default(0)
  clicks              Int                 @default(0)
  replies             Int                 @default(0)
  repliedAt           DateTime?
  externalId          String?             // ID Resend / Buffer / Twitter pour tracking
  leadId              String?
  // Patch HAUTE Phase 3 : tracking UTM pour attribution conversion (fenêtre 7j)
  utmSource           String?             // "ceo"
  utmCampaign         String?             // playbook ID (P1-P7) ou "backlink_haro" etc.
  utmMedium           String?             // channel (email, twitter, linkedin, ig)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  lead CeoLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([channel])
  @@index([leadId])
  @@index([sentAt]) // requêtes attribution rolling 7j
  @@index([direction])
}

/// Snapshot quotidien des KPIs CEO (alimente dashboard `/admin/ceo`).
/// Cron `/api/cron/ceo-kpis-snapshot` insère 1 ligne/jour à 5h UTC.
model CeoKpiSnapshot {
  id                        String   @id @default(cuid())
  date                      DateTime @unique @db.Date
  // North Star : (opens + replies + clicks) / total_sent sur 30j glissants
  northStarEngagement30d    Float
  // Satellites
  emailReplyRate            Float
  siteReturn48h             Float
  emailOpenRate             Float
  // Opérationnels
  killSwitchTriggers24h     Int
  directorFailRate          Float
  draftsAutoSendRatio       Json     // { email: 0.8, twitter: 0.3, ... }
  costPerAcquiredSubscriber Float?   // null si 0 conversion attribuée
  ceoAttributedConversions  Int
  backlinksDaSum            Int      // somme DA des backlinks acquis
  createdAt                 DateTime @default(now())

  @@index([date])
}

/// Backlinks — pitchs envoyés et acquisitions.
model CeoBacklink {
  id             String              @id @default(cuid())
  source         CeoBacklinkSource
  domain         String
  url            String?
  pageTitle      String?
  anchorText     String?
  da             Int?
  daReportedBy   String?             // "moz_free" | "hypothese" | "gsc"
  linkType       String?             // "dofollow" | "nofollow" | "unknown"
  status         CeoBacklinkStatus   @default(PITCHED)
  relevanceScore Int?                // 1-10, score filtrage CEO
  pitchedAt      DateTime            @default(now())
  repliedAt      DateTime?
  acquiredAt     DateTime?
  verifiedAt     DateTime?
  notes          String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([domain])
  @@index([source])
}

/// Audit trail RGPD — rétention 3 ans obligatoire (CNIL art. 30).
/// PII masqué : `targetIdHashed` = SHA256(email ou handle), JAMAIS de PII clair.
model CeoAuditLog {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  action          String   // "email_sent" | "dm_replied" | "backlink_pitched" | "task_contested" | ...
  targetType      String   // "user" | "journalist" | "blogger" | "lead"
  targetIdHashed  String   // SHA256(email ou handle)
  channel         String
  aiDecisionScore Int?     // score Director ou Haiku triage
  aiModel         String?  // "haiku-4.5" | "sonnet-4.6" | "opus-4.7"
  reasoning       String?  @db.Text // raisonnement bref (1 phrase) — pas de PII
  outcome         String   // "sent" | "rejected" | "draft" | "error" | "skipped"
  errorMessage    String?  @db.Text
  contestedAt     DateTime?

  @@index([timestamp])
  @@index([targetIdHashed])
  @@index([action])
}

/// Déduplication anti-spam intra-canal — fenêtre 24h glissante.
/// Hash = SHA256(channel + recipient + content_first_100chars).
model CeoDedup {
  id          String   @id @default(cuid())
  contentHash String   @unique
  channel     String
  sentAt      DateTime @default(now())

  @@index([contentHash])
  @@index([sentAt])
}

/// Blacklist commentaires proactifs — humoristes pros, influenceurs >10k, journalistes.
model CeoCommentBlacklist {
  id        String   @id @default(cuid())
  handle    String
  platform  String   // "twitter" | "linkedin" | "instagram"
  reason    String   // "humoriste_pro" | "influenceur_10k" | "journaliste"
  createdAt DateTime @default(now())

  @@unique([handle, platform])
  @@index([platform])
}

