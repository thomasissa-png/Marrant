// Schéma Prisma — deviens-marrant.fr
// Base de données PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH — NextAuth.js
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// UTILISATEURS
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash      String?
  passwordChangedAt DateTime?
  plan              Plan      @default(FREE)
  level         UserLevel @default(NOVICE)
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations NextAuth
  accounts Account[]
  sessions Session[]

  // Relations métier
  favorites    UserFavorite[]
  subscription Subscription?
  jokeLikes    JokeLike[]
  pathProgress  UserPathProgress[]

  @@index([email])
}

enum Plan {
  FREE
  PREMIUM
}

enum UserLevel {
  NOVICE
  APPRENTI
  FARCEUR
  COMIQUE
  LEGENDE
}

// ==========================================
// BLAGUES
// ==========================================

model Joke {
  id            String        @id @default(cuid())
  content       String        @db.Text
  punchline     String        @db.Text
  category      JokeCategory
  maturityLevel Int           @default(1) // 1-5
  type          JokeType      @default(CLASSIQUE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  generatedByAI Boolean       @default(false)

  // Relations
  dailyContents DailyContent[]
  favorites     UserFavorite[]
  likes         JokeLike[]

  @@index([category])
  @@index([isActive])
}

enum JokeCategory {
  AUTODERISION
  SITUATION
  ABSURDE
  OBSERVATIONNEL
  JEUX_DE_MOTS
  CULTUREL
  COUPLE
  BOULOT
  ECOLE
  GAMING
  RESEAUX_SOCIAUX
  DATING
  SOIREES
  PARENTS
}

enum JokeType {
  SUBTIL
  CLASSIQUE
  ABSURDE
  ONE_LINER
  STORY
  DIALOGUE
  QA
}

model JokeLike {
  id        String   @id @default(cuid())
  userId    String
  jokeId    String
  isLike    Boolean  // true = like, false = dislike
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joke Joke @relation(fields: [jokeId], references: [id], onDelete: Cascade)

  @@unique([userId, jokeId])
}

// ==========================================
// CONSEILS
// ==========================================

model Tip {
  id         String        @id @default(cuid())
  title      String
  content    String        @db.Text
  category   TipCategory
  difficulty TipDifficulty
  example    String        @db.Text
  exercise   String        @db.Text
  isActive      Boolean       @default(true)
  generatedByAI Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  dailyContents DailyContent[]
  favorites     UserFavorite[]
  pathSteps     LearningPathStep[]

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
}

enum TipCategory {
  TIMING
  AUTODERISION
  OBSERVATION
  REPARTIE
  STORYTELLING
  ABSURDE
  JEUX_DE_MOTS
}

enum TipDifficulty {
  DEBUTANT
  INTERMEDIAIRE
  EXPERT
}

// ==========================================
// PARCOURS D'APPRENTISSAGE
// ==========================================

model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  slug        String   @unique
  duration    String   // ex: "4 semaines"
  difficulty  TipDifficulty
  icon        String   // emoji
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       LearningPathStep[]
  userProgress UserPathProgress[]

  @@index([isActive])
}

model LearningPathStep {
  id              String       @id @default(cuid())
  learningPathId  String
  tipId           String
  order           Int
  dayNumber       Int          // Jour dans le parcours

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  tip          Tip          @relation(fields: [tipId], references: [id])

  @@unique([learningPathId, order])
  @@index([learningPathId])
}

model UserPathProgress {
  id              String       @id @default(cuid())
  userId          String
  learningPathId  String
  currentStep     Int          @default(0)
  completedSteps  Int[]        // Array of completed step orders
  startedAt       DateTime     @default(now())
  completedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
}

// ==========================================
// VIDÉOS
// ==========================================

model Video {
  id          String          @id @default(cuid())
  youtubeId   String          @unique
  title       String
  channelName String
  duration    String          // Format ISO 8601 (PT5M30S)
  category    TipCategory     // Même catégories que les conseils
  difficulty  TipDifficulty   // Même niveaux que les conseils
  description String          @db.Text
  technique   String          // Technique humoristique principale
  learnings   String[]        // Points clés à retenir de la vidéo
  exercise    String?         @db.Text  // Exercice pratique lié à la vidéo
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  generatedByAI Boolean         @default(false)

  // Relations
  dailyContents DailyContent[]
  favorites     UserFavorite[]

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
}

// ==========================================
// CONTENU DU JOUR
// ==========================================

model DailyContent {
  id      String   @id @default(cuid())
  date    DateTime @unique @db.Date
  jokeId  String
  tipId   String
  videoId String?

  joke  Joke   @relation(fields: [jokeId], references: [id])
  tip   Tip    @relation(fields: [tipId], references: [id])
  video Video? @relation(fields: [videoId], references: [id])

  @@index([date])
}

// ==========================================
// PLAN DE CONTENU MENSUEL (agents IA)
// ==========================================

model ContentPlan {
  id          String          @id @default(cuid())
  agentType   ContentAgentType
  month       Int             // 1-12
  year        Int
  entries     ContentPlanEntry[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([agentType, month, year])
}

model ContentPlanEntry {
  id            String         @id @default(cuid())
  planId        String
  dayOfMonth    Int            // 1-31
  category      String         // catégorie prévue
  theme         String         // thème/sujet prévu
  targetPersona String         // YANIS | SOPHIE | MARC
  status        PlanEntryStatus @default(PLANNED)
  contentId     String?        // ID du contenu créé (joke/tip/video)
  createdAt     DateTime       @default(now())

  plan ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayOfMonth])
  @@index([planId])
  @@index([status])
}

enum ContentAgentType {
  JOKE
  TIP
  VIDEO
  SEO_BLOG
}

enum SeoEntryStatus {
  PLANNED
  PUBLISHED
  SKIPPED
}

enum PlanEntryStatus {
  PLANNED
  PUBLISHED
  SKIPPED
}

// ==========================================
// FAVORIS
// ==========================================

model UserFavorite {
  id          String      @id @default(cuid())
  userId      String
  contentType ContentType
  jokeId      String?
  tipId       String?
  videoId     String?
  createdAt   DateTime    @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joke  Joke?  @relation(fields: [jokeId], references: [id], onDelete: Cascade)
  tip   Tip?   @relation(fields: [tipId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, jokeId])
  @@unique([userId, contentType, tipId])
  @@unique([userId, contentType, videoId])
  @@index([userId])
}

enum ContentType {
  JOKE
  TIP
  VIDEO
}

// ==========================================
// ABONNEMENTS (Stripe)
// ==========================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ==========================================
// BLOG (Agent SEO)
// ==========================================

model BlogArticle {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  excerpt     String            @db.Text
  content     String            @db.Text
  category    String
  readingTime String
  targetKeyword String          // mot-clé principal ciblé
  metaTitle   String?           // title SEO custom si différent du titre
  metaDescription String?       @db.Text
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  generatedByAI Boolean         @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([isPublished])
  @@index([slug])
  @@index([publishedAt])
}

model SeoCalendar {
  id            String          @id @default(cuid())
  weekNumber    Int             // 1-52
  year          Int
  targetKeyword String          // mot-clé cible pour cet article
  articleTitle  String?         // titre planifié
  status        SeoEntryStatus  @default(PLANNED)
  articleId     String?         // ID de l'article créé
  notes         String?         @db.Text // notes de l'agent sur le choix
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([weekNumber, year])
  @@index([status])
}
