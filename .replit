run = "cd apps/web && npm run start"
entrypoint = "apps/web/src/app/page.tsx"

[deployment]
run = ["sh", "-c", "cd apps/web && npm run start -- -H 0.0.0.0 -p 5000"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
HOSTNAME = "0.0.0.0"
NODE_ENV = "production"
