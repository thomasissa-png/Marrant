run = "cd apps/web && npm run start"
entrypoint = "apps/web/src/app/page.tsx"

# Le build se fait avant le déploiement (bouton Deploy) ou via le shell
# Shell Replit : cd apps/web && npm run setup && npm run build

[deployment]
build = ["sh", "-c", "cd apps/web && npm install && npx prisma generate && npx prisma db push && npm run build"]
run = ["sh", "-c", "cd apps/web && npm run start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
HOSTNAME = "0.0.0.0"
