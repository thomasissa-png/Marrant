run = "cd apps/web && npm install && npx prisma generate && npx prisma db push && npm run build && npm run start"
entrypoint = "apps/web/src/app/page.tsx"

[deployment]
run = ["sh", "-c", "cd apps/web && npm run start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
HOSTNAME = "0.0.0.0"
